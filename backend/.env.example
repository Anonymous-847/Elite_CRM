# Copy this file to ".env" and fill in your real values.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/elite_digital_hub

# Or MongoDB Atlas (cloud, recommended for cPanel — no local Mongo install needed):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/elite_digital_hub

# cPanel's Node.js Selector sets this automatically — leave it as a fallback for local dev.
PORT=5000

# The frontend is now served by this same app (same-origin), so CORS rarely
# matters in production. "*" is fine unless you specifically call this API
# from a different domain.
CORS_ORIGIN=*
